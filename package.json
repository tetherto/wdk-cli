{
  "name": "@tetherto/wdk-cli",
  "version": "1.0.0-beta.3",
  "description": "CLI tool for Wallet Development Kit (WDK)",
  "keywords": [
    "wdk",
    "cli",
    "wallet",
    "mcp"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/wdk-cli.git"
  },
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "wdk.config.json",
    "wdk.tokens.json",
    "SKILL.md"
  ],
  "bin": {
    "wdk": "./bin/wdk.mjs",
    "wdk-mcp": "./bin/wdk-mcp.mjs",
    "wdk-daemon": "./bin/wdk-daemon.mjs"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "sync-modules": "node scripts/sync-module-deps.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {}
  },
  "standard": {
    "ignore": [
      "tests/**"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@inquirer/prompts": "8.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tetherto/wdk": "1.0.0-beta.6",
    "@tetherto/wdk-asset-registry": "1.0.0-beta.2",
    "@tetherto/wdk-protocol-fiat-moonpay": "1.0.0-beta.2",
    "@tetherto/wdk-utils": "1.0.0-beta.11",
    "@tetherto/wdk-wallet": "1.0.0-beta.7",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.8",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.11",
    "@tetherto/wdk-wallet-evm-erc-4337": "1.0.0-beta.6",
    "@tetherto/wdk-wallet-solana": "1.0.0-beta.7",
    "@tetherto/wdk-wallet-spark": "1.0.0-beta.17",
    "@tetherto/wdk-wallet-tron": "1.0.0-beta.9",
    "bignumber.js": "11.1.1",
    "bip39": "3.1.0",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "14.0.3",
    "conf": "15.1.0",
    "ora": "9.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
